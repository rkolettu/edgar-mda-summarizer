SEC_USER_AGENT=Your Name Research (you@example.com)
GEMINI_API_KEY=your-gemini-api-key
# Optional: models for the research pipeline's AI stages (defaults gemini-3.5-flash-lite and gemini-3.8-flash; GEMINI_MODEL
# is tried next, so a project that can only use 2.5 models still works).
GEMINI_EXTRACT_MODEL=
GEMINI_SYNTH_MODEL=
GEMINI_AUDIT_MODEL=
# Optional: Mistral's free tier, used only when every Gemini model is out of quota or unavailable.
MISTRAL_API_KEY=
# Optional: Postgres connection string for the permanent analysis store (Vercel's Neon integration sets it).
DATABASE_URL=
# Optional: secret that enables POST /api/cache/clear via the X-Admin-Token header.
CACHE_ADMIN_TOKEN=
